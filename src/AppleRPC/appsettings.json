{
  // Create an application named "Apple Music" at https://discord.com/developers/applications
  // and paste its APPLICATION ID here (see README). It is public, not a secret.
  "DiscordApplicationId": "",

  // "it" or "en" (tray menu language)
  "Language": "it",

  // Which part of the activity Discord shows in the member-list status:
  // 0 = app name ("Listening to Apple Music"), 1 = artist, 2 = song title.
  "StatusDisplayType": 2,

  // What to do when playback is paused:
  //  -1 = keep the presence (without the progress bar) forever
  //   0 = clear it immediately
  //   N = keep it for N seconds, then clear it
  "PauseClearAfterSeconds": 120,

  // Discord allows one presence update every 15 seconds; don't go lower.
  "MinUpdateIntervalSeconds": 15,

  // Shows the "Star on GitHub" button. You can't see your own buttons on your own profile.
  "ShowGitHubButton": true,

  // Art asset key (Developer Portal > Rich Presence > Art Assets) used when no cover is found.
  "DefaultAsset": "applerpc",

  // The Apple Music session is picked when its AppUserModelId contains one of these (case-insensitive).
  "AppleMusicSourceIds": [ "AppleMusic", "AppleInc.AppleMusicWin" ],

  "Artwork": {
    "Enabled": true,
    "ItunesCountry": "US",
    "UseArtistPhoto": true,
    "RequestTimeoutSeconds": 6,
    "MaxRetries": 2,
    "LookupBudgetSeconds": 8,
    "CacheDays": 30
  },

  "Logging": {
    // Trace, Debug, Information, Warning, Error
    "Level": "Information",
    "MaxFileSizeKB": 1024,
    "MaxFiles": 3
  }
}
